{
  "name": "kampania",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:web": "esbuild src/main.tsx --bundle --minify --format=iife --jsx=automatic --alias:lucide-react=./shim/lucide.tsx --define:process.env.NODE_ENV=\\\"production\\\" --target=chrome80 --outfile=www/app.js",
    "apk": "npm run build:web && npx cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
